{
  "name": "taoread",
  "version": "0.1.0",
  "private": true,
  "description": "桃阅读 — 家庭睡前共读仪式应用（TaoRead）",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm run test --workspaces --if-present",
    "audit:touch": "node scripts/audit-touch.mjs",
    "perf:child": "node scripts/perf/measure-child.mjs",
    "verify": "npm run audit:touch && npm run typecheck && npm run lint && npm run test",
    "dev:server": "npm run dev -w @taoread/server",
    "dev:web": "npm run dev -w @taoread/web",
    "smoke:weread": "npm run smoke -w @taoread/server",
    "demo": "node scripts/demo.mjs",
    "e2e": "playwright test -c e2e/playwright.config.ts --grep-invert @visual",
    "e2e:visual": "playwright test -c e2e/playwright.config.ts --grep @visual",
    "mobile:build": "npm run build:web -w @taoread/mobile",
    "mobile:sync": "npm run build:web -w @taoread/mobile && npm run sync -w @taoread/mobile"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "@tauri-apps/cli@^2": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-legacy": "^5.4.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "msedge-tts": "^2.1.1",
    "playwright": "^1.63.0",
    "terser": "^5.51.2",
    "typescript-eslint": "^8.69.0",
    "web-vitals": "6.2.3"
  }
}
