# 服务端口
PORT=8787
TAO_HOST=127.0.0.1

# dev | test | prod
NODE_ENV=dev

# 主密钥：用于加密存储各家庭的微信读书 API Key（>=16 位随机字符串，绝不提交）
# 生成示例：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TAO_MASTER_KEY=

# CORS 允许来源（开发默认 *）
TAO_ALLOWED_ORIGIN=*

# 可选：本机联调/冒烟测试用的微信读书 API Key（wrk- 开头，绝不提交）
WEREAD_API_KEY=

# SQLite 数据库连接（相对 prisma 目录）
TAO_DATABASE_URL="file:./dev.db"

# 就寝时刻（本地日内分钟数，默认 21:30=1290，之后不开新书）；off 关闭
TAO_BEDTIME=1290
