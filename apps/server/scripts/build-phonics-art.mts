const artDir = path.resolve('..', '..', 'docs', 'phonics', 'art')
await mkdir(artDir, { recursive: true })
const destDir = path.join(mediaRoot, 'phonics', 'taoread-phonics-gb-v1')
await mkdir(destDir, { recursive: true })

const course = await loadCourse(candidateDirectory)
const slots = course.assets.filter(a => a.purpose === 'image' && a.sha256 === null && a.id.endsWith('-meaning-image'))
const missing: string[] = []
for (const slot of slots) {
  const word = slot.id.replace(/^w-/, '').replace(/-meaning-image$/, '')
  const body = art[word]
  if (!body) { missing.push(word); continue }
  const svg = open + body + close
  await writeFile(path.join(artDir, `${word}.svg`), svg, 'utf8')
  const webp = await sharp(Buffer.from(svg)).png().webp({ quality: 88 }).toBuffer()
  const sha256 = createHash('sha256').update(webp).digest('hex')
  await writeFile(path.join(destDir, `${sha256}.webp`), webp)
  slot.sha256 = sha256
  slot.extension = 'webp'
  slot.sourceLicense = 'Original SVG illustration authored for taoread (in-repo docs/phonics/art); teaching and rights review pending'
}
if (missing.length) throw Error(`No artwork for: ${missing.join(', ')}`)
const assetsPath = path.join(candidateDirectory, 'assets.json')
await writeFile(assetsPath, JSON.stringify(course.assets, null, 2) + '\n', 'utf8')
const manifestPath = path.join(candidateDirectory, 'manifest.json')
const manifest = JSON.parse(await readFile(manifestPath, 'utf8')) as Record<string, unknown>
manifest.contentHash = courseHash(course)
await writeFile(manifestPath, JSON.stringify(manifest, null, 2) + '\n', 'utf8')
console.log(JSON.stringify({ bound: slots.length, artwork: Object.keys(art).length, contentHash: manifest.contentHash }))
