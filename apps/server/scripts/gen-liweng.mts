  coverArt: 'poetry-moon-pair',
  coverArtPrompt: '对联意境：左边一位小书生、右边一轮明月与青山遥遥相对，中间一行竖排小字，古风水墨贴纸绘本风',
  coverFrom: '#7A9E9F',
  coverTo: '#EFE6D5',
