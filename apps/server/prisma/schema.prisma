// 桃阅读数据模型初稿（第 1 夜起草，第 2 夜安装 Prisma 后 validate + migrate 并随实现微调）
// 约定（docs/02 §4.4）：
//  - 所有时间戳在数据库层用 DateTime，序列化层对外统一转 Unix 秒；
//  - 不收集任何儿童真实身份信息（昵称/头像为家长设置的展示值）；
//  - API Key 仅以密文形态存在于 weread_binding.ciphertext。
//  - 阅读时长单位：秒。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("TAO_DATABASE_URL")
}

model Family {
  id             String   @id @default(cuid())
  code           String   @unique // 家庭码：加入家庭的凭据
  createdAt      DateTime @default(now())
  /// 家庭级护眼设置（第 9 夜）：null=回落服务端默认（TAO_BEDTIME / 300s）
  bedtimeMin     Int?
  overtimeCapSec Int?

  children     ChildProfile[]
  binding      WereadBinding?
  snapshots    ShelfSnapshot[]
  cosessions   Cosession[]
  highlights   HighlightStar[]
  achievements Achievement[]
  prompts      ParentPrompt[]
  reports      WeeklyReport[]
  events       EventLog[]
}

model ChildProfile {
  id        String   @id @default(cuid())
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  nickname  String // 展示昵称，非真实姓名
  avatar    String? // 本地图片引用，非外链
  stage     String // 3-5 | 6-8 | 9-12
  createdAt DateTime @default(now())

  cosessions   Cosession[]
  highlights   HighlightStar[]
  achievements Achievement[]
  reading      ReadingProgress[]

  @@index([familyId])
}

model WereadBinding {
  id         String    @id @default(cuid())
  familyId   String    @unique
  family     Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  ciphertext String // AES-256-GCM 密文（v1.salt.iv.tag.ct）
  maskedTail String // 尾 4 位，回显用
  status     String    @default("active") // active | unverified | invalid
  lastSyncAt DateTime?
  createdAt  DateTime  @default(now())
}

model BookCache {
  bookId    String   @id // 微信读书 bookId
  title     String
  author    String
  cover     String?
  category  String?
  intro     String?
  chapters  String? // JSON 序列化的章节目录
  deepLink  String? // 网关回包原值，绝不自行拼接
  newRating Int? // 0-100
  fetchedAt DateTime @default(now())
}

model ShelfSnapshot {
  id             String    @id @default(cuid())
  familyId       String
  family         Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  bookId         String
  kind           String // book | album | mp
  title          String
  author         String?
  cover          String?
  category       String?
  finished       Boolean   @default(false)
  blocked        Boolean   @default(false) // 家长单书屏蔽
  readUpdateTime DateTime?
  syncedAt       DateTime  @default(now())

  @@unique([familyId, bookId, kind]) // 最左前缀已覆盖 familyId 查询，无需冗余索引
}

model Cosession {
  id           String       @id @default(cuid())
  familyId     String
  family       Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  childId      String
  child        ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  bookId       String? // 微信读书书（纸质书共读为空）
  paperTitle   String? // 纸质书书名（手动录入）
  startedAt    DateTime
  endedAt      DateTime?
  durationSec  Int? // endedAt - startedAt，秒
  progressMark String? // little | lot | done
  mood         String? // happy | excited | calm | sleepy | thinking
  createdAt    DateTime     @default(now())

  highlights HighlightStar[]

  @@index([familyId, startedAt])
  @@index([childId])
}

model HighlightStar {
  id          String       @id @default(cuid())
  familyId    String
  family      Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  childId     String
  child       ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  cosessionId String?
  cosession   Cosession?   @relation(fields: [cosessionId], references: [id], onDelete: SetNull)
  source      String // weread | voice | manual
  text        String // 金句原文/孩子口述
  markCount   Int? // 来源为 weread 时：多少人划过这句
  createdAt   DateTime     @default(now())

  @@index([familyId])
  @@index([childId])
}

model Achievement {
  id         String       @id @default(cuid())
  familyId   String
  family     Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  childId    String
  child      ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  kind       String // night_lamp | streak_best | book_done（纪念式，无兑换）
  value      Int // 如夜灯第 N 晚 / 连续 N 晚
  unlockedAt DateTime     @default(now())

  @@unique([childId, kind, value]) // 同一成就只解锁一次（幂等）；最左前缀已覆盖 childId 查询
}

model ParentPrompt {
  id         String   @id @default(cuid())
  familyId   String
  family     Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  bookId     String
  stage      String // 3-5 | 6-8 | 9-12
  tellPoints String // JSON：讲什么（3 条要点）
  questions  String // JSON：问什么（3 个开放式问题，按年龄段梯度）
  hook       String? // 聊什么：「爸妈小时候」话题钩子
  genType    String   @default("template") // template | llm
  nightKey   String? // YYYY-MM-DD（nights.ts 口径）；同家庭同书同晚唯一（N4-007）
  createdAt  DateTime @default(now())

  @@unique([familyId, bookId, stage, nightKey]) // nightKey 非空时唯一（部分唯一索引见迁移）
  @@index([familyId, bookId])
}

model WeeklyReport {
  id            String   @id @default(cuid())
  familyId      String
  family        Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  weekStart     DateTime // 必须由唯一的规范化函数生成（如 Date.UTC(y, m, d-weekday)），禁止各处自行构造；第 2 夜落地时配套工具函数 + 单测
  stats         String // JSON：共读晚数/累计分钟/书目/金句回顾/下周建议
  shareImageUrl String?
  createdAt     DateTime @default(now())

  @@unique([familyId, weekStart])
}

// ── v2 内容域（CBF：Canonical Book Format，docs/07 §3）──
// 书 = 章 = 块。块是阅读器渲染与 TTS 的最小单位。
// 内容域 bookId 以 `cbf:` 前缀注入共读会话，与微信读书 bookId 永不冲突。

model Book {
  id        String            @id // 稳定 slug，如 sanzi-jing；共读会话引用时加 cbf: 前缀
  title     String
  author    String?
  lang      String // zh | en
  category  String // poetry 古诗 | primer 蒙学 | story 故事 | tale 童话
  ageStage  String // 3-5 | 6-8 | 9-12
  intro     String?
  coverArt  String // 封面 SVG 场景键（见 web 端 SceneArt）
  coverFrom String? // 封面渐变起点色
  coverTo   String? // 封面渐变终点色
  words     Int               @default(0)
  source    String // 版权台账摘要：公版来源与年限说明
  createdAt DateTime          @default(now())
  chapters  Chapter[]
  progress  ReadingProgress[]

  @@index([lang, category])
}

model Chapter {
  id     String  @id @default(cuid())
  bookId String
  book   Book    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  order  Int
  title  String
  art    String? // 章节 SVG 场景键
  blocks Block[]

  @@unique([bookId, order])
  @@index([bookId])
}

model Block {
  id          String  @id @default(cuid())
  chapterId   String
  chapter     Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  order       Int
  kind        String // text 段落 | poem 诗句 | note 小贴士 | image 插图
  text        String
  pinyin      String? // 拼音（poem/primer 块；按字注音，空格分词）
  translation String? // 白话译文/注释
  art         String? // image 块的 SVG 场景键

  @@unique([chapterId, order])
  @@index([chapterId])
}

/// AI 生图产物（docs/13 P0-A）：把 SVG 场景键升级为绘本风插画。
/// scene 与 Book.coverArt / Chapter.art / Block.art 同键；前端优先取 ArtAsset，
/// 无记录时回退 SceneArt SVG（不阻断、不降级体验）。
model ArtAsset {
  id        String   @id @default(cuid())
  scene     String   @unique // cover:<bookSlug> | chapter:<bookSlug>:<order> | mascot:<name>
  kind      String // cover | chapter | mascot
  urlPath   String // /api/media/art/...（媒体静态服务直取）
  width     Int
  height    Int
  bytes     Int
  prompt    String // 生成所用 prompt（留痕可审计）
  model     String // 生图模型标识
  createdAt DateTime @default(now())
}

/// AI 视频产物（docs/13 P0-E）：把章节场景变成 5 秒动画。
/// 异步任务：先建行（queued），轮询到结果后回填 urlPath。
/// scene 与 ArtAsset 同键，一个场景一个视频（重生成覆盖）。
model VideoAsset {
  id        String   @id @default(cuid())
  scene     String   @unique // chapter:book:order 等，与 ArtAsset 同键空间
  kind      String // chapter | cover
  taskId    String // agnes video_id，轮询用
  status    String // queued | rendering | completed | failed
  prompt    String
  seconds   Int      @default(5)
  urlPath   String? // 完成后：/api/media/videos/xxx.mp4
  width     Int      @default(0)
  height    Int      @default(0)
  bytes     Int      @default(0)
  model     String
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// 权利台账（docs/07 §2 修改三）：只录公版或自有内容，字段留痕可审计
model RightsLedger {
  id              String   @id @default(cuid())
  bookId          String   @unique
  workTitle       String
  author          String?
  authorDeathYear Int? // 作者卒年（PD 判定核心）
  translator      String? // 译者（如有，另有译者权利）
  jurisdiction    String // CN | US | EU
  basis           String // pd-70 | pd-us | original | adapted
  sourceUrl       String?
  note            String?
  createdAt       DateTime @default(now())
}

/// 孩子在内容域书籍上的阅读进度（章序 + 块序）
model ReadingProgress {
  id           String       @id @default(cuid())
  childId      String
  child        ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  bookId       String
  book         Book         @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapterOrder Int          @default(1)
  blockOrder   Int          @default(0)
  finished     Boolean      @default(false)
  updatedAt    DateTime     @updatedAt

  @@unique([childId, bookId])
  @@index([childId])
}

model EventLog {
  id       String   @id @default(cuid())
  familyId String
  family   Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  role     String // child | parent | system
  event    String // ritual_started | book_selected | departure_clicked | ...
  props    String? // JSON 附加属性
  ts       DateTime @default(now())

  @@index([familyId, ts]) // 最左前缀已覆盖 familyId 查询
}
